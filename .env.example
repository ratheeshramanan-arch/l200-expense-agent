# Copy this file to .env for local development ONLY.
# NEVER commit a real .env file or API keys to version control.
# In production, secrets are loaded automatically from Google Cloud Secret Manager.

GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# Set to true only for local offline/dev runs when Secret Manager is unavailable
ALLOW_LOCAL_ENV_FALLBACK=true

# Secret Manager secret names (resolved via SecretManagerProvider in production)
GEMINI_API_KEY_SECRET_NAME=gemini-api-key
SESSION_DB_URL_SECRET_NAME=session-db-url

# Local-only fallbacks (replace locally in .env, never commit real values)
GEMINI_API_KEY=replace-with-local-dev-key-or-use-secret-manager
SESSION_DB_URL=sqlite+aiosqlite:///./expense_sessions.db

# Optional Google Cloud integrations
ENABLE_CLOUD_DLP=false
ENABLE_CLOUD_TRACE=false
ENABLE_MODEL_ARMOR=false
VERTEX_AI_MEMORY_ENGINE_ID=
VERTEX_AI_SEARCH_DATASTORE_ID=
